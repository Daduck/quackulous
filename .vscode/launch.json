{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Quackulous Debug Client",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-msvc/stage/Debug/tremulous.x86_64.exe",
      "args": [
        "+set",
        "fs_basepath",
        "${workspaceFolder}/build/windows-msvc/stage/Debug",
        "+set",
        "fs_homepath",
        "${workspaceFolder}/build/windows-msvc/stage/Debug",
        "+set",
        "sv_pure",
        "0",
        "+set",
        "vm_ui",
        "0",
        "+set",
        "vm_cgame",
        "0",
        "+set",
        "vm_game",
        "0"
      ],
      "cwd": "${workspaceFolder}/build/windows-msvc/stage/Debug",
      "externalConsole": false,
      "preLaunchTask": "bootstrap-build-debug",
      "stopAtEntry": false
    }
  ]
}
