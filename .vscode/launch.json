{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Quackulous Debug Client",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-msvc/stage/Debug/tremulous.x86_64.exe",
      "args": [
        "+set",
        "sv_pure",
        "0"
      ],
      "cwd": "${workspaceFolder}/build/windows-msvc/stage/Debug",
      "console": "integratedTerminal",
      "preLaunchTask": "bootstrap-build-debug",
      "stopAtEntry": false
    }
  ]
}
